{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "nkash-blog",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// The zone is in the same Cloudflare account, so wrangler provisions the DNS
	// record and the TLS certificate on first deploy. Nothing to set up by hand.
	"routes": [
		{
			"pattern": "blogs.nkash.dev",
			"custom_domain": true
		}
	],
	// Post rows and the asset index. Create with:
	//   npx wrangler d1 create nkash-blog
	// then paste the returned database_id here — it is an identifier, not a
	// secret, and is safe to commit.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nkash-blog",
			"database_id": "79de9314-32b8-4839-b3a4-77c029c7d013",
			"migrations_dir": "migrations"
		}
	],
	// Images and attachments — not enabled yet.
	//
	// R2 requires a one-time activation in the Cloudflare dashboard that asks
	// for a payment method, even though the free tier (10 GB, no egress fees)
	// costs nothing. Nothing in the request path touches this binding until
	// image upload is built, so it stays commented out rather than forcing a
	// card on file for an unbuilt feature.
	//
	// To enable: activate R2 in the dashboard, then
	//   npx wrangler r2 bucket create nkash-blog-media
	// and uncomment. Deliberately no public r2.dev URL — objects are served
	// through the Worker so the same canView() that gates a post gates its
	// images.
	//
	// "r2_buckets": [
	// 	{
	// 		"binding": "MEDIA",
	// 		"bucket_name": "nkash-blog-media"
	// 	}
	// ],
	"observability": {
		"enabled": true
	}
}
