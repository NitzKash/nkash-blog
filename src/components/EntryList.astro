---
import Tier from './Tier.astro';
import type { Post } from '../lib/data';

// Typed against the store, not `CollectionEntry<'posts'>` — that collection
// was removed when posts moved to D1, so the old annotation referred to
// something that no longer exists and silently typed `entry` as unusable.
interface Props {
  entries: Post[];
  empty?: string;
}

const { entries, empty = 'Nothing here yet.' } = Astro.props;

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

{
  entries.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ul class="entries">
      {entries.map((entry) => (
        <li class="entry">
          <time datetime={entry.data.pubDate.toISOString()}>
            {dateFormat.format(entry.data.pubDate)}
          </time>
          <div>
            <h3 class="entry-title">
              <a href={`/posts/${entry.id}`}>{entry.data.title}</a>
              <Tier visibility={entry.data.visibility} draft={entry.data.draft} />
            </h3>
          </div>
          <p class="entry-desc">
            {entry.data.description}
            {/* Only contributors get a byline. The site owner's posts are the
                default here, and marking every row would be noise. */}
            {entry.author && <span class="byline">by {entry.author}</span>}
          </p>
        </li>
      ))}
    </ul>
  )
}
