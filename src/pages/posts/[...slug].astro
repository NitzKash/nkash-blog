---
import Base from '../../layouts/Base.astro';
import Tier from '../../components/Tier.astro';
import SignIn from '../../components/SignIn.astro';
import { posts as postStore } from '../../lib/data';
import { canView } from '../../lib/visibility';
import { publicCacheHeaders, privateCacheHeaders } from '../../lib/cache';

const { viewer, audience, memberStatus } = Astro.locals;
const { slug } = Astro.params;

const post = slug ? await postStore.get(slug) : null;

/**
 * What an unauthorised viewer is told depends on the tier, deliberately:
 *
 *   circle  → a gate page. The slug is already shareable by design, so
 *             confirming the post exists costs nothing and "sign in to read
 *             this" beats a bewildering 404 for someone who was sent the link.
 *   private → a plain 404, byte-identical to a post that does not exist, so
 *             the existence of owner-only drafts is not probeable.
 */
if (!post) return new Response(null, { status: 404 });

const allowed = canView(post.data, audience, viewer);
const hideEntirely = !allowed && (post.data.visibility === 'private' || post.data.draft);

if (hideEntirely) return new Response(null, { status: 404 });

const isPublic = post.data.visibility === 'public' && !post.data.draft;

if (allowed) {
  const headers = isPublic && audience === 'anonymous' ? publicCacheHeaders() : privateCacheHeaders();
  for (const [key, value] of Object.entries(headers)) Astro.response.headers.set(key, value);
} else {
  for (const [key, value] of Object.entries(privateCacheHeaders())) {
    Astro.response.headers.set(key, value);
  }
  Astro.response.status = viewer ? 403 : 401;
}

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={allowed ? post.data.title : 'Restricted'}
  description={allowed ? post.data.description : undefined}
  noindex={!isPublic}
>
  {
    allowed ? (
      <article>
        <header class="article-head">
          <h1>{post.data.title}</h1>
          <div class="article-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {dateFormat.format(post.data.pubDate)}
            </time>
            <span>·</span>
            <span>{post.readingMinutes} min</span>
            <Tier visibility={post.data.visibility} draft={post.data.draft} />
            {audience === 'owner' && (
              <a href={`/admin/editor?slug=${encodeURIComponent(post.id)}`}>edit</a>
            )}
          </div>
        </header>
        {/* Rendered at save time, by the author, who is always an owner. */}
        <div class="prose" set:html={post.html} />
      </article>
    ) : (
      <div class="notice">
        <h2>This one's not public.</h2>
        {viewer ? (
          memberStatus === 'blocked' ? (
            <p>
              You're signed in as <strong>{viewer.login ?? viewer.email}</strong>, but your request
              wasn't approved. The public vault is still open to you.
            </p>
          ) : (
            <p>
              You're signed in as <strong>{viewer.login ?? viewer.email}</strong> and you're in the
              queue — <strong>waiting on nkash to approve you</strong>. Until then, enjoy the public
              vault only.
            </p>
          )
        ) : (
          <>
            <p>Sign in and I'll check whether you're on the list for it.</p>
            <SignIn next={Astro.url.pathname} />
          </>
        )}
      </div>
    )
  }
</Base>
